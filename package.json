{
  "name": "atomic-rate-limiter",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --shims && copyfiles -u 2 src/scripts/*.lua dist/scripts",
    "dev": "tsup src/index.ts --watch",
    "example": "npm run build && tsx examples/express-app/server.ts"
  },
  "keywords": ["rate-limiter", "redis", "express", "middleware", "sliding-window", "atomic-rate-limiter", "api-limit"],
  "author": "Aryan Kaushal",
  "license": "MIT",
  "description": "A high-performance Redis rate-limiter using sliding window log algorithms, with out-of-the-box Express middleware support.",
  "dependencies": {
    "ioredis": "^5.10.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.3.5",
    "copyfiles": "^2.4.1",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  }
}
